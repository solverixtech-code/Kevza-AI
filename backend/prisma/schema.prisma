generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  HOT
  WON
  LOST
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  POLICY_BLOCKED
}

enum TemplateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(TRIAL)
  timezone  String       @default("Asia/Kolkata")
  country   String       @default("IN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  contacts          Contact[]
  leads             Lead[]
  whatsappAccounts  WhatsappAccount[]
  messageTemplates  MessageTemplate[]
  campaigns         Campaign[]
  conversations     Conversation[]
  messages          Message[]
  knowledgeSources  KnowledgeSource[]
  knowledgeChunks   KnowledgeChunk[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  name         String
  phone        String?
  passwordHash String?
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[] @relation("LeadOwner")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phoneE164 String?
  email     String?
  city      String?
  source    String?
  dnd       Boolean  @default(false)
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]
  conversations Conversation[]

  @@unique([tenantId, phoneE164])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
}

model Lead {
  id             String     @id @default(uuid())
  tenantId       String
  contactId      String
  ownerId        String?
  status         LeadStatus @default(NEW)
  score          Int        @default(0)
  priority       String     @default("cold")
  qualification  Json?
  nextActionAt   DateTime?
  lastContactedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, score])
  @@index([tenantId, ownerId])
  @@index([tenantId, nextActionAt])
}

model WhatsappAccount {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String   @default("meta_cloud")
  wabaId          String?
  phoneNumberId   String?
  displayPhone    String?
  status          String   @default("NOT_CONNECTED")
  qualityStatus   String?
  tokenCiphertext String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates     MessageTemplate[]
  conversations Conversation[]

  @@index([tenantId, status])
  @@unique([provider, phoneNumberId])
}

model MessageTemplate {
  id                String         @id @default(uuid())
  tenantId          String
  whatsappAccountId String?
  providerTemplateId String?
  name              String
  category          String
  language          String         @default("en")
  body              String
  status            TemplateStatus @default(DRAFT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
}

model Campaign {
  id          String         @id @default(uuid())
  tenantId    String
  templateId  String?
  name        String
  objective   String
  status      CampaignStatus @default(DRAFT)
  audienceJson Json?
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
}

model Conversation {
  id                String   @id @default(uuid())
  tenantId          String
  contactId         String
  whatsappAccountId String?
  status            String   @default("OPEN")
  aiMode            String   @default("ASSIST")
  assigneeId        String?
  serviceWindowUntil DateTime?
  summary           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, contactId])
}

model Message {
  id             String           @id @default(uuid())
  tenantId       String
  conversationId String
  campaignId     String?
  direction      MessageDirection
  status         MessageStatus    @default(QUEUED)
  providerMessageId String?
  content        String
  intent         String?
  aiGenerated    Boolean          @default(false)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
}

model KnowledgeSource {
  id        String   @id @default(uuid())
  tenantId  String
  type      String
  title     String
  status    String   @default("UPLOADED")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
}

model KnowledgeChunk {
  id        String   @id @default(uuid())
  tenantId  String
  sourceId  String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceId])
}
